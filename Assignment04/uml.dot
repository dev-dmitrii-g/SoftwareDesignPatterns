digraph HospitalAdmission {
  graph [
    label="Hospital Admission Class Diagram",
    labelloc=t,
    fontsize=24,
    fontname="Helvetica",
    fontcolor="#17324d",
    bgcolor="white",
    rankdir=TB,
    nodesep=0.45,
    ranksep=0.7,
    splines=polyline,
    pad=0.3
  ];
  node [shape=record, fontname="Helvetica", fontsize=12, color="#59758c", fontcolor="#17324d", style="filled", fillcolor="white", margin="0.16,0.10"];
  edge [color="#70889b", arrowsize=0.7, penwidth=1.3];

  WebServer [label="{webServer|db : *sql.DB\lintake : IntakeFacade\ladmin : AdminFacade\l|admit()\lstock()\lstate()\linspect()\lresume()\lcompensate()\l}", fillcolor="#eaf4ff"];

  subgraph cluster_facades {
    label="facades";
    fontname="Helvetica";
    fontsize=18;
    fontcolor="#17324d";
    style="rounded,filled";
    color="#b6cddd";
    fillcolor="#f4f9fc";
    IntakeFacade [label="{IntakeFacade|Gateway\lInsurance : Verifier\lEquipment : Reserver\lPharmacy : Dispatcher\l|Start()\lAdmit()\lResume()\lcompensate()\l}", fillcolor="#eaf4ff"];
    AdminFacade [label="{AdminFacade|Intake : IntakeFacade\l|Inspect()\lCompensate()\l}", fillcolor="#eaf4ff"];
    Gateway [label="{Gateway|DB : *sql.DB\l|Create()\lGet()\lList()\lUpdate()\l}"];
    Admission [label="{Admission|ID · IIN · Coverage\lEquipment · Medicine\lStatus · Reason\l}"];
  }

  subgraph cluster_insurance {
    label="A  insuranceverifier";
    fontname="Helvetica";
    fontsize=18;
    fontcolor="#17324d";
    style="rounded,filled";
    color="#b6cddd";
    fillcolor="#f4f9fc";
    Verifier [label="{Verifier|Rule · Repository\l|Verify()\lReverse()\l}", fillcolor="#e5f2ff"];
    InsuranceRule [label="{Rule|Check(iin, coverage)\l}"];
    InsuranceRepository [label="{Repository|DB : *sql.DB\l|Save()\lGet()\l}"];
    Verification [label="{Verification|AdmissionID · IIN\lCoverage · Status\l|NEW → VERIFIED → REVERSED\l}"];
  }

  subgraph cluster_equipment {
    label="B  equipmentreserver";
    fontname="Helvetica";
    fontsize=18;
    fontcolor="#17324d";
    style="rounded,filled";
    color="#b6cddd";
    fillcolor="#f4f9fc";
    Reserver [label="{Reserver|Rule · Repository\l|Reserve()\lRelease()\l}", fillcolor="#e5f2ff"];
    EquipmentRule [label="{Rule|Check(item)\l}"];
    EquipmentRepository [label="{Repository|DB : *sql.DB\l|SetStock()\lReserve()\lRelease()\lGet()\l}"];
    Reservation [label="{Reservation|AdmissionID · Item\lStatus\l|NEW → RESERVED → RELEASED\l}"];
  }

  subgraph cluster_pharmacy {
    label="C  pharmacydispatcher";
    fontname="Helvetica";
    fontsize=18;
    fontcolor="#17324d";
    style="rounded,filled";
    color="#b6cddd";
    fillcolor="#f4f9fc";
    Dispatcher [label="{Dispatcher|Rule · Repository\l|Dispatch()\l}", fillcolor="#e5f2ff"];
    PharmacyRule [label="{Rule|Check(medicine)\l}"];
    PharmacyRepository [label="{Repository|DB : *sql.DB\l|SetStock()\lDispatch()\lGet()\l}"];
    Dispatch [label="{Dispatch|AdmissionID · Medicine\lStatus\l|NEW → DISPATCHED → CANCELLED\l}"];
  }

  SQLite [shape=cylinder, label="SQLite\ninsurance · equipment · pharmacy\nstock · admissions", fillcolor="#e9f5ec", color="#60916d"];

  WebServer -> IntakeFacade;
  WebServer -> AdminFacade;
  AdminFacade -> IntakeFacade;
  IntakeFacade -> Gateway;
  IntakeFacade -> Verifier;
  IntakeFacade -> Reserver;
  IntakeFacade -> Dispatcher;
  Gateway -> Admission;
  Gateway -> SQLite;
  Verifier -> InsuranceRule;
  Verifier -> InsuranceRepository;
  InsuranceRepository -> Verification;
  InsuranceRepository -> SQLite;
  Reserver -> EquipmentRule;
  Reserver -> EquipmentRepository;
  EquipmentRepository -> Reservation;
  EquipmentRepository -> SQLite;
  Dispatcher -> PharmacyRule;
  Dispatcher -> PharmacyRepository;
  PharmacyRepository -> Dispatch;
  PharmacyRepository -> SQLite;

}
